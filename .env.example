# Copie este arquivo para ".env.local" (que NÃO vai para o GitHub) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# "supabase" = dados na nuvem com login (produção) · "local" = navegador, sem login (testes offline)
VITE_STORAGE_DRIVER=supabase

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://csqxwlfgtaskunqtaqkb.supabase.co
# Chave pública "anon" (pode ficar no frontend; a proteção é feita por RLS no banco).
VITE_SUPABASE_ANON_KEY=

# NUNCA coloque aqui a "service_role" key nem a senha do banco.
